        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class ClientBase {\n        &lt;&lt;abstract&gt;&gt;\n        -int _id\n        -string _phone\n        -string _passportSeriesNumber\n        #string PhonePattern$\n        #string PassportPattern$\n        #ClientBase(int id, string phone, string passport)\n        +int Id\n        +string Phone\n        +string PassportSeriesNumber\n        +GetShortName()* string\n        +ToShortString() string\n        +ToString() string\n        +IsValidId(int id)$ bool\n        +IsValidPhone(string phone)$ bool\n        +IsValidPassportSeriesNumber(string passport)$ bool\n        #ValidateRegex(string value, string pattern, bool isRequired)$ bool\n        #ValidateLength(string value, int maxLength, bool isRequired)$ bool\n    }\n    class Client {\n        -string _lastName\n        -string _firstName\n        -string _middleName\n        -string _email\n        -string _address\n        +Client(int id, string lastName, string firstName, string middleName, string phone, string email, string passport, string address)\n        +Client(int id, string lastName, string firstName, string phone, string passport)\n        +Client(string rawData)\n        +Client(JsonElement jsonElement)\n        +string LastName\n        +string FirstName\n        +string MiddleName\n        +string Email\n        +string Address\n        +GetShortName() string\n        +ToFullString() string\n        +ToString() string\n        +Equals(Client other) bool\n        +IsValidLastName(string lastName)$ bool\n        +IsValidFirstName(string firstName)$ bool\n        +IsValidMiddleName(string middleName)$ bool\n        +IsValidEmail(string email)$ bool\n        +IsValidAddress(string address)$ bool\n    }\n    class ClientShort {\n        -string _shortName\n        +ClientShort(int id, string shortName, string phone, string passport)\n        +ClientShort(Client client)\n        +ClientShort(string rawData)\n        +string ShortName\n        +GetShortName() string\n        +Equals(ClientShort other) bool\n        +IsValidShortName(string shortName)$ bool\n    }\n    class Client_rep_base {\n        &lt;&lt;abstract&gt;&gt;\n        #string FilePath\n        #List~Client~ Clients\n        #Client_rep_base()\n        #Client_rep_base(string filePath)\n        +ReadAll()* List~Client~\n        +WriteAll()* void\n        +GetById(int id) Client\n        +Get_k_n_short_list(int k, int n) List~ClientShort~\n        +SortByField() void\n        +Add(Client client) Client\n        +ReplaceById(int id, Client updatedClient) bool\n        +DeleteById(int id) bool\n        +GetCount() int\n        #EnsureDirectoryExists() void\n    }\n    class Client_rep_json {\n        -JsonSerializerOptions JsonOptions$\n        +Client_rep_json(string filePath)\n        +ReadAll() List~Client~\n        +WriteAll() void\n    }\n    class Client_rep_yaml {\n        -ISerializer YamlSerializer$\n        -IDeserializer YamlDeserializer$\n        +Client_rep_yaml(string filePath)\n        +ReadAll() List~Client~\n        +WriteAll() void\n    }\n    class Client_rep_DB_Adapter {\n        -Client_rep_DB _dbRepository\n        +Client_rep_DB_Adapter(Client_rep_DB dbRepository)\n        +Client_rep_DB_Adapter(string connectionString)\n        +ReadAll() List~Client~\n        +WriteAll() void\n        +GetById(int id) Client\n        +Get_k_n_short_list(int k, int n) List~ClientShort~\n        +SortByField() void\n        +Add(Client client) Client\n        +ReplaceById(int id, Client updatedClient) bool\n        +DeleteById(int id) bool\n        +GetCount() int\n    }\n    class Client_rep_DB {\n        -DatabaseConnection _db\n        +Client_rep_DB(string connectionString)\n        +Client_rep_DB(DatabaseConnection db)\n        +GetById(int id) Client\n        +Get_k_n_short_list(int k, int n) List~ClientShort~\n        +Add(Client client) Client\n        +ReplaceById(int id, Client updatedClient) bool\n        +DeleteById(int id) bool\n        +GetCount() int\n        +GetAll() List~Client~\n    }\n    class DatabaseConnection {\n        &lt;&lt;Singleton&gt;&gt;\n        -DatabaseConnection _instance$\n        -object LockObj$\n        -string _connectionString\n        -DatabaseConnection(string connectionString)\n        +GetInstance(string connectionString)$ DatabaseConnection\n        +ExecuteQuery(string sql, Dictionary parameters) DataTable\n        +ExecuteScalar~T~(string sql, Dictionary parameters) T\n        +ExecuteNonQuery(string sql, Dictionary parameters) int\n    }\n    ClientBase &lt;|-- Client\n    ClientBase &lt;|-- ClientShort\n    ClientShort ..&gt; Client\n    Client_rep_base &lt;|-- Client_rep_json\n    Client_rep_base &lt;|-- Client_rep_yaml\n    Client_rep_base &lt;|-- Client_rep_DB_Adapter\n    Client_rep_DB_Adapter o--&gt; Client_rep_DB\n    Client_rep_DB o--&gt; DatabaseConnection\n    Client_rep_base ..&gt; Client\n    Client_rep_base ..&gt; ClientShort&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="p1vG6ef2ZRrvkCyv2YCU-1">
